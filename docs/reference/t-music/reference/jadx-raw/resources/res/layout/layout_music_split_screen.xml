<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:id="@+id/rl_split_album"
        android:background="@drawable/album_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <com.p060tw.music.view.CircleImageView
            android:layout_gravity="center"
            android:id="@+id/iv_split_album"
            android:layout_width="174dp"
            android:layout_height="174dp"/>
    </FrameLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="27dp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_split_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="27dp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_split_singer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"/>
    <TextView
        android:textSize="27dp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_split_albumName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"/>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_main_prev_split_screen"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/btn_prev"
            android:scaleType="center"
            android:onClick="onClick"/>
        <ImageView
            android:id="@+id/iv_main_play_split_screen"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/btn_pp"
            android:scaleType="center"
            android:onClick="onClick"/>
        <ImageView
            android:id="@+id/iv_main_next_split_screen"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/btn_next"
            android:scaleType="center"
            android:onClick="onClick"/>
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
