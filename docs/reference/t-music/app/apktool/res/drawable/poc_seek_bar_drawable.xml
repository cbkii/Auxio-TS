<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="10.0dp" />
            <solid android:color="#545454" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:gravity="center_vertical" android:id="@android:id/progress">
        <shape android:shape="rectangle">
            <size android:height="10.0dp" />
            <corners android:radius="10.0dp" />
            <solid android:color="#c47803" />
        </shape>
    </item>
</layer-list>
