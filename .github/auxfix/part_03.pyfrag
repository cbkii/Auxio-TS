                    L.w(e, "EQ/DSP candidate was denied: $candidate")
                } catch (e: RuntimeException) {
                    L.w(e, "EQ/DSP candidate failed at launch: $candidate")
                }
            }
            if (!launched) requireContext().showToast(R.string.err_no_equalizer_app)
''',
