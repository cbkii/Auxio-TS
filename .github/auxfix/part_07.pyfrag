            // promotion deadline. Promote before applying optional window suppression.
            if (!promoteForeground()) {
                stopSelfCleanly()
                return START_NOT_STICKY
            }
            isForegroundPromoted = true
            if (!shouldSuppressForForegroundPreference()) startOverlayRuntime()
            return START_STICKY
''',
)
