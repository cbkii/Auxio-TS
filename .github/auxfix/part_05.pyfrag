                Intent.CATEGORY_DEFAULT,
            ),
            NativeTarget(
                ComponentName("com.tw.dsp", "com.tw.dsp.MainActivity"),
                Intent.CATEGORY_LAUNCHER,
            ),
            NativeTarget(
                ComponentName("com.syu.eq", "com.syu.eq.MainActivity"),
                Intent.CATEGORY_LAUNCHER,
