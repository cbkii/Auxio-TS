                startActivity(
                    Intent(intent)
                        .setClass(this, MainActivity::class.java)
                        .addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP)
                )
            }
        }
        finish()
    }
}
''',
)

# Manifest: route the fixed alias, remove second launcher icon, retain internal overlay Activity.
manifest = "app/src/topwayCompat/AndroidManifest.xml"
replace_once(
