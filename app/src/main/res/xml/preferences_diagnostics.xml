<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:title="@string/set_diagnostics">

    <PreferenceCategory app:title="Status" xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
        <Preference
            app:key="@string/set_head_unit_compat_status"
            app:summary="@string/set_head_unit_compat_status_desc"
            app:title="@string/set_head_unit_compat_status" />

        <Preference
            app:key="@string/set_key_ts18_source_repair_status"
            app:summary="@string/set_ts18_source_repair_status_desc"
            app:title="@string/set_ts18_source_repair_status" />

        <Preference
            app:key="@string/set_key_root_fs_status"
            app:summary="@string/set_root_fs_status_desc"
            app:title="@string/set_root_fs_status" />

        <Preference
            app:key="@string/set_key_ts18_fast_resume_status"
            app:summary="@string/set_ts18_fast_resume_status_desc"
            app:title="@string/set_ts18_fast_resume_status" />

        <Preference
            app:key="car_overlay_status"
            app:title="Floating Controls Permission" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Diagnostics">
        <Preference
            app:key="run_check"
            app:title="Run DoFun integration check"
            app:summary="Tap to run checks" />
        <Preference
            app:key="export_report"
            app:title="Export DoFun integration report"
            app:summary="Copy the check results to clipboard"
            android:enabled="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Root-assisted test actions (Advanced)"
        app:iconSpaceReserved="false">
        <Preference
            app:key="test_stock_disable"
            app:title="Disable stock com.tw.music for user 0"
            app:summary="Reversibly disable the stock music app to test DoFun fallback to Auxio. Requires root enabled." />
        <Preference
            app:key="restore_stock"
            app:title="Re-enable stock com.tw.music"
            app:summary="Restore the stock music app." />
    </PreferenceCategory>

</PreferenceScreen>
