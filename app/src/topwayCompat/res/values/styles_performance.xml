<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        TS18 metadata/list text is updated frequently and does not need EmojiCompat span processing.
        Keep this override in the shared Topway source set so both maintained head-unit variants
        avoid that work without changing Auxio's generic base resource policy.
    -->
    <style name="Widget.Auxio.TextView.Base" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="emojiCompatEnabled">false</item>
    </style>
</resources>
