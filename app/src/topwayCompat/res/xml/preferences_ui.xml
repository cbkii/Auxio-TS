<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_ui">

    <org.oxycblt.auxio.settings.ui.IntListPreference
        app:defaultValue="@integer/theme_auto"
        app:entries="@array/entries_theme"
        app:entryIcons="@array/icons_theme"
        app:entryValues="@array/values_theme"
        app:icon="@drawable/ic_light_24"
        app:key="@string/set_key_theme"
        app:title="@string/set_theme" />

    <org.oxycblt.auxio.settings.ui.WrappedDialogPreference
        app:icon="@drawable/ic_accent_dynamic_24"
        app:key="@string/set_key_accent"
        app:title="@string/set_accent" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/set_key_black_theme"
        app:summary="@string/set_black_mode_desc"
        app:title="@string/set_black_mode" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="@string/set_key_round_mode"
        app:summary="@string/set_round_mode_desc"
        app:title="@string/set_round_mode" />


    <PreferenceCategory
        app:title="@string/set_head_unit">

        <org.oxycblt.auxio.settings.ui.StringListPreference
            app:defaultValue="@string/visualizer_mode_off"
            app:entries="@array/entries_visualizer_mode"
            app:entryValues="@array/values_visualizer_mode"
            app:key="@string/set_key_visualizer_mode"
            app:title="@string/set_visualizer_mode"
            app:summary="@string/set_visualizer_mode_desc" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_driver_side"
            app:summary="@string/set_driver_side_desc"
            app:title="@string/set_driver_side" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_head_unit_large_controls"
            app:summary="@string/set_head_unit_large_controls_desc"
            app:title="@string/set_head_unit_large_controls" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_head_unit_album_art"
            app:summary="@string/set_head_unit_album_art_desc"
            app:title="@string/set_head_unit_album_art" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_head_unit_dashboard_quick_access"
            app:summary="@string/set_head_unit_dashboard_quick_access_desc"
            app:title="@string/set_head_unit_dashboard_quick_access" />

        <Preference
            app:key="@string/set_head_unit_compat_status"
            app:summary="@string/set_head_unit_compat_status_desc"
            app:title="@string/set_head_unit_compat_status" />

        <Preference
            app:key="@string/set_key_ts18_source_repair_status"
            app:summary="@string/set_ts18_source_repair_status_desc"
            app:title="@string/set_ts18_source_repair_status" />

        <Preference
            app:key="@string/set_key_ts18_fast_resume_status"
            app:summary="@string/set_ts18_fast_resume_status_desc"
            app:title="@string/set_ts18_fast_resume_status" />

        <Preference
            app:key="@string/set_key_ts18_startup_scanning_policy"
            app:summary="@string/set_ts18_startup_scanning_policy_desc"
            app:title="@string/set_ts18_startup_scanning_policy" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="@string/set_key_use_root_fs"
            app:summary="@string/set_use_root_fs_desc"
            app:title="@string/set_use_root_fs" />

        <Preference
            app:key="@string/set_key_root_fs_status"
            app:summary="@string/set_root_fs_status_desc"
            app:title="@string/set_root_fs_status" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_ts18_system_source_filter"
            app:summary="@string/set_ts18_system_source_filter_desc"
            app:title="@string/set_ts18_system_source_filter" />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/car_overlay_setting_title">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="car_overlay_enabled"
            app:summary="@string/car_overlay_setting_summary"
            app:title="@string/car_overlay_setting_title" />

        <Preference
            app:key="car_overlay_reset_position"
            app:title="@string/car_overlay_reset_position"
            app:dependency="car_overlay_enabled" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="car_overlay_hide_auxio_fg"
            app:summary="@string/car_overlay_hide_auxio_fg_desc"
            app:title="@string/car_overlay_hide_auxio_fg"
            app:dependency="car_overlay_enabled" />

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="90"
            app:entries="@array/entries_car_overlay_opacity"
            app:entryValues="@array/values_car_overlay_opacity"
            app:key="car_overlay_opacity"
            app:summary="@string/car_overlay_opacity_desc"
            app:title="@string/car_overlay_opacity"
            app:dependency="car_overlay_enabled" />
    </PreferenceCategory>

</PreferenceScreen>
