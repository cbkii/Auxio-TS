<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Topway/head-unit capabilities belong only to Topway distribution variants. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <!-- Android 14+ special-use declaration. Android 10 ignores it; runtime code API-gates use. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="com.dofun.variety" />
        <package android:name="com.tw.music" />
        <package android:name="com.tw.media" />
        <package android:name="com.tw.service.xt" />
        <package android:name="com.tw.eq" />
        <package android:name="com.tw.dsp" />
        <package android:name="com.syu.eq" />
        <package android:name="com.syu.dsp" />
        <package android:name="com.ts.MainUI" />
        <package android:name="com.ts.mainui" />
        <package android:name="com.zjinnova.eq" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!-- External clients see only the stock-compatible wrapper. It delegates to AuxioService. -->
        <service
            android:name="org.oxycblt.auxio.AuxioService"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported">
            <intent-filter tools:node="remove">
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <service
            android:name="com.tw.music.MusicService"
            android:foregroundServiceType="mediaPlayback"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- DoFun addresses com.tw.music.MusicActivity under either accepted Topway package. -->
        <activity
            android:name="org.oxycblt.auxio.MainActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.tw.music.MusicActivity"
            android:targetActivity="org.oxycblt.auxio.MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/info_topway_music_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name="org.oxycblt.auxio.headunit.topway.TopwayMusicBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tw.music.action.cmd" />
                <action android:name="com.tw.music.action.prev" />
                <action android:name="com.tw.music.action.next" />
                <action android:name="com.tw.music.action.pp" />
                <action android:name="com.android.launcher.widget_music_progress" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="org.oxycblt.auxio.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.tw.music.view.MusicWidgetProvider"
            android:exported="true"
            android:label="@string/info_topway_music_app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name="org.oxycblt.auxio.car.overlay.CarFloatingControlsService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:ignore="ForegroundServicePermission">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Car floating playback controls overlay for head-unit displays" />
        </service>

        <activity
            android:name="org.oxycblt.auxio.car.overlay.CarOverlayActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:label="@string/car_overlay_setting_title"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="org.oxycblt.auxio.action.LAUNCH_FLOATING_CONTROLS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="org.oxycblt.auxio.car.overlay.FloatingControlsLauncher"
            android:targetActivity="org.oxycblt.auxio.car.overlay.CarOverlayActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/car_overlay_launcher_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="org.oxycblt.auxio.car.overlay.CarOverlayPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Auxio.App" />

        <receiver
            android:name="org.oxycblt.auxio.car.overlay.CarOverlayBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="org.oxycblt.auxio.car.overlay.ACTION_RESTORE_OVERLAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
